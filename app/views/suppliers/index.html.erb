<div class="container">
  <h1>ANAGRAFICHE FORNITORI</h1>
  <br>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div class="d-flex">
    <%= link_to 'Nuovo Forinitore', new_supplier_path, class:"btn btn-warning" %>
  </div>

  <div class="d-flex justify-content-end">
  <%= form_tag suppliers_path, method: :get, class: "form-inline" do %>
    <div class="form-group mx-sm-3 mb-2">
      <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Cerca fornitore" %>
    </div>
    <%= submit_tag "Cerca", class: "btn btn-primary mb-2" %>
  <% end %>
</div>


  </br>
  <div class="row">
    <div class="col-12">
      <table class="table" >
        <thead class="thead-dark">
  <!-- Table headers -->
  <tr>
    <th><%= link_to "Nome", :sort => "name"%> </th>
    <th><%= link_to "Descrizione completa (Nome, P.IVA, Indirizzo)", :sort => "full_name"%> </th>
    <th><%= link_to "Email", :sort => "email"%> </th>
    <th>Ordini</th>
    <th colspan="2"></th>
  </tr>
        </thead>
        <tbody>
  <!-- Table rows -->
  <% @suppliers.each do |supplier| %>
    <tr>
      <td><%= supplier.name %></td>
      <td><%= supplier.full_name %></td>
      <td><%= supplier.email %></td>
      <td><%= link_to supplier.orders.count, show_orders_supplier_path(supplier) %></td>
      <td><%= link_to 'Modifica', edit_supplier_path(supplier), class: "btn btn-dark" %></td>
      <td><%= button_to 'Elimina', supplier_path(supplier), method: :delete, class: "btn btn-danger" %></td>
      <!-- <td><%= link_to 'Elimina', supplier, method: :delete, data: { confirm: 'Sei sicuro?'} %></td> -->
    </tr>
  <% end %>
        </tbody>
</table>
      <div class="d-flex justify-content-center">
        <%= will_paginate @suppliers %>
      </div>
      <br>
    <div class="text-center">
      <%= page_entries_info @suppliers %>
    </div>
      <br>
      <br>
    </div>
  </div>
</div>

