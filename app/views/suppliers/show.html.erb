<div class="container">

<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <div class="bg-white p-5 rounded-lg shadow-md">
      <h2 class="text-2xl font-semibold mb-4"><%= @supplier.name %></h2>
      <p class="text-gray-600"><strong>Email:</strong> <%= @supplier.email %></p>
      <p class="text-gray-600"><strong>Phone:</strong> <%= @supplier.phone %></p>
      <p class="text-gray-600"><strong>Partita IVA:</strong> <%= @supplier.vat_number %></p>
      <p class="text-gray-600"><strong>Codice Fiscale:</strong> <%= @supplier.tax_code %></p>
      <p class="text-gray-600"><strong>Indirizzo:</strong> <%= @supplier.address %></p>
      <p class="text-gray-600"><strong>Città:</strong> <%= @supplier.city %></p>
      <p class="text-gray-600"><strong>CAP:</strong> <%= @supplier.zip_code %></p>
      <p class="text-gray-600"><strong>Paese:</strong> <%= @supplier.country %></p>
      <p class="text-gray-600"><strong>Note:</strong> <%= @supplier.notes %></p>
      <p class="text-gray-600"><strong>Attivo:</strong> <%= @supplier.active? ? "Sì" : "No" %></p>
    </div>
  </div>
</div>

  <div class="field">
    <%= link_to 'Indietro', suppliers_path, class: "btn btn-light" %>
    <%= link_to 'Modifica', edit_supplier_path(@supplier), class: "btn btn-dark" %>
  </div>
<br>
  <%= button_to 'Elimina', supplier_path(@supplier), method: :delete, class: "btn btn-danger" %>




</div>