<div class="container">
  <h1>AZIENDE</h1>
  <br>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="d-flex justify-content-end">
    <%= form_tag companies_path, method: :get, class: "form-inline" do %>
      <div class="form-group mx-sm-3 mb-2">
        <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Cerca azienda" %>
      </div>
      <%= submit_tag "Cerca", class: "btn btn-primary mb-2" %>
    <% end %>
  </div>

  <br>
  <div class="row">
    <div class="col-12">
      <table class="table">
        <thead class="thead-dark">
        <tr>
          <th>Azienda</th>
          <th colspan="2"></th>
        </tr>
        </thead>
        <tbody>
        <% @companies.each do |company| %>
          <tr>
            <td><%= company.name %></td>
            <td><%= link_to 'Login', select_company_path(company), class: "btn btn-dark" %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>