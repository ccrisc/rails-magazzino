<div class="container">
  <h1>CATEGORIE</h1>
  <br>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div class="d-flex">
    <%= link_to 'Nuova Categoria', new_category_path, class:"btn btn-warning" %>
  </div>

  <div class="d-flex justify-content-end">
    <%= form_tag categories_path, method: :get, class: "form-inline" do %>
      <div class="form-group mx-sm-3 mb-2">
        <%= text_field_tag :search, params[:search], class: "form-control", placeholder: "Cerca categoria" %>
      </div>
      <%= submit_tag "Cerca", class: "btn btn-primary mb-2" %>
    <% end %>
  </div>


  </br>
  <div class="row">
    <div class="col-12">
      <table class="table" >
        <thead class="thead-dark">
        <!-- Table headers -->
        <tr>
          <th><%= link_to "Categoria", :sort => "name"%> </th>
          <th colspan="2"></th>
        </tr>
        </thead>
        <tbody>
        <!-- Table rows -->
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.name %></td>
            <td><%= link_to 'Modifica', edit_category_path(category), class: "btn btn-dark" %></td>
            <td><%= button_to 'Elimina', category_path(category), method: :delete, class: "btn btn-danger" %></td>
            <!-- <td><%= link_to 'Elimina', category, method: :delete, data: { confirm: 'Sei sicuro?'} %></td> -->
          </tr>
        <% end %>
        </tbody>
      </table>
      <div class="d-flex justify-content-center">
        <%= will_paginate @categories %>
      </div>
      <br>
      <div class="text-center">
        <%= page_entries_info @categories %>
      </div>
      <br>
      <br>
    </div>
  </div>
</div>

