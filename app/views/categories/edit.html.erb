<div class="container">
  <div class="d-flex">
    <h2>Modifica Categoria</h2>
  </div>

  <%= form_with model: @category, id: dom_id(@category, "form"), class: "table min-w-full", method: :patch do |form| %>
    <div>
      <%= form.label :Nome %>
      <br>
      <%= form.text_field :name %>
      <%= @category.errors[:name].first if @category.errors[:name].any? %>
    </div>
    <br>

    <div class="inline">
      <td><%= link_to 'Annulla', categories_path, class: "btn btn-light" %></td>
      <td><%= form.submit 'Conferma', class: 'btn btn-primary' %></td>
    </div>
  <% end %>
</div>
